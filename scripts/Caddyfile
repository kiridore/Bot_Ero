# BotEro 站点配置：导航主页（根域）静态托管 + 6 个子域统一反代单进程 webapp（Host 头透传，按域分发页面）
# 用法：caddy run --config scripts/Caddyfile 或复制到 /etc/caddy/Caddyfile

littlero.tech {
	root * /home/dore/onebot/Bot_Ero/homepage
	file_server
}

gallery.littlero.tech {
	reverse_proxy 127.0.0.1:8765
}


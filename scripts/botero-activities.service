[Unit]
Description=BotEro Activities
After=network.target

[Service]
WorkingDirectory=/home/dore/onebot/Bot_Ero
Environment=BOTERO_DB_PATH=/home/dore/onebot/Bot_Ero/data.db
Environment=BOTERO_AUTH_SALT=BotEro-Gallery-ChangeMe
# 换盐时把旧盐加进来，旧密钥仍有效：BOTERO_AUTH_SALT_OLD=旧盐值
Environment=BOTERO_GALLERY_PORT=8770
ExecStart=/usr/bin/python3 -m activities
Restart=always

[Install]
WantedBy=multi-user.target

# BotEro 共享环境文件 —— bot（main.py 启动时加载）与 webapp（systemd EnvironmentFile）的唯一来源。
# 修改此处后需重启对应进程生效。
#
# BOTERO_AUTH_SALT（登录密钥盐，HMAC）：
#   bot 的 plugins/gallery_login_key 生成密钥、webapp 的 core.auth 验证密钥，共用此值。
#   换盐：改成新盐值；若想让旧密钥继续有效，把旧盐追加到 BOTERO_AUTH_SALT_OLD（逗号分隔可多个）。
BOTERO_AUTH_SALT=BotEro-Gallery-ChangeMe
# BOTERO_AUTH_SALT_OLD=旧盐1,旧盐2
# 社区时间线（Event Server）：
#   BOTERO_TIMELINE_URL —— Event Server 基地址（bot 插件发送事件的目标）
#   BOTERO_EVENT_TOKEN  —— 系统间事件令牌（bot 发送与 webapp 校验共用，与用户登录密钥不同）
BOTERO_TIMELINE_URL=http://127.0.0.1:8765
BOTERO_EVENT_TOKEN=BotEro-Timeline-ChangeMe

# 小埃周报：消息日志独立库 / Web 基址 / 群通知开关（首周测试期保持 0）
# BOTERO_MESSAGE_LOG_DB_PATH=<仓库>/server_data/message_log.db
# BOTERO_WEB_BASE_URL=https://littlero.tech
# BOTERO_WEEKLY_NOTIFY=0
